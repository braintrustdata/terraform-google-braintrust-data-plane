# Braintrust supplies the customer-specific tfvars file. These values are examples only.
project_id                        = "customer-project"
project_number                    = "123456789012"
region                            = "us-central1"
bootstrap_id                      = "bsp_019d1234-8abc-7def-8123-456789abc111"
braintrust_bridge_service_account = "example-bootstrap@braintrust-byoc-example.iam.gserviceaccount.com"
enable_diagnostics                = true
labels                            = { environment = "customer" }

# Set this to true to include the reviewed quota requests in Terraform apply.
request_quotas      = false
quota_contact_email = "cloud-admin@customer.example"

# Each bucket defaults to region with a separate module-created KMS key.
state_storage = {
  location = "us-central1"
}
evidence_storage = {
  location = "US"
  # For configurable dual-region placement, supply both regions.
  # data_locations = ["us-east1", "us-west1"]
  # An existing key must match the location code, including multi-region codes.
  # kms_key = "projects/customer-project/locations/us/keyRings/customer/cryptoKeys/evidence"
}

# License values stay outside tfvars. Each referenced secret must already exist.
# license_secrets = ["projects/customer-project/secrets/brainstore-license-key"]
